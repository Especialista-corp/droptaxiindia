# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas — pagamentos Pix / escrow (obrigatório para o fluxo de pagamento)
# https://www.asaas.com/ — use as credenciais de sandbox durante o desenvolvimento.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Google Maps JS API — rastreamento ao vivo do prestador (opcional; sem isso o
# mapa mostra um aviso e o restante do app funciona normalmente)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (opcional) — gere um par de chaves VAPID com `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@montaja.com.br

# Resend — e-mails transacionais (opcional; sem isso apenas a notificação in-app é registrada)
RESEND_API_KEY=
RESEND_FROM_EMAIL="MontaJá <contato@montaja.com.br>"

# Protege as rotas /api/cron/* (defina o mesmo valor no agendador de cron)
CRON_SECRET=
