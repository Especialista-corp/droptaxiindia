# ZapLivre · configuração do servidor
# Copie para .env e preencha. Nada aqui vai para o repositório.

# --- Essencial ---
# Domínio onde o aplicativo vai responder. Precisa apontar para este servidor.
DOMINIO=zaplivre.seudominio.com.br
# E-mail para o certificado HTTPS (avisos de vencimento).
EMAIL_HTTPS=voce@seudominio.com.br

# --- Como as pessoas entram ---
# invite = piloto fechado por convite, sem custo de SMS.
# open   = telefone + código por SMS (exige SMS_WEBHOOK_URL).
ACCESS_MODE=invite
# Endereço que recebe {to, message} e dispara o SMS. Só no modo open.
SMS_WEBHOOK_URL=
# @usuários que podem emitir convites, além da primeira conta do servidor.
ADMIN_USERNAMES=

# --- Notificação com o aplicativo fechado ---
# Deixe vazio na primeira subida: o servidor gera e guarda as chaves sozinho.
# Para trocar de servidor mantendo os aparelhos inscritos, copie as chaves
# geradas (tabela app_settings) para cá.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br

# --- Transcrição de áudio (opcional) ---
# Um dos dois. Sem nenhum, a transcrição usa o resumo local, mais simples.
TRANSCRIBE_WEBHOOK_URL=
OPENAI_API_KEY=

# --- Cobrança das empresas (opcional) ---
BILLING_WEBHOOK_SECRET=

# --- NUNCA em produção ---
# DEV_SHOW_OTP=1 mostra o código de qualquer telefone na resposta.
# Em produção, deixaria qualquer um entrar como qualquer um.

# --- Rede ---
# Quantos proxies existem entre a internet e o aplicativo. 1 = o porteiro do
# docker-compose. Confiar em todos deixaria forjar o IP de origem e furar o
# limite de tentativas de entrada.
TRUST_PROXY=1
