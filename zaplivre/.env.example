PORT=3000
DB_FILE=./data/zaplivre.db
# URL que recebe POST {"to":"+55...","message":"..."} e envia o SMS
SMS_WEBHOOK_URL=
# Apenas desenvolvimento: devolve o código de verificação na resposta
DEV_SHOW_OTP=1
UPLOAD_DIR=./data/uploads
# Segredo do webhook do provedor de pagamento (Asaas, Pagar.me, Stripe...)
BILLING_WEBHOOK_SECRET=
# Transcrição de áudio (opcional): chave compatível com a API da OpenAI (Whisper)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
SUMMARY_MODEL=
# Ou um serviço próprio que recebe o áudio e devolve {"text": "..."}
TRANSCRIBE_WEBHOOK_URL=
